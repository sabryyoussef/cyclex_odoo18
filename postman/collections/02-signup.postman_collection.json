{
	"info": {
		"name": "02 - Sign Up",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Sign Up (customer)",
			"event": [
				{
					"listen": "test",
					"script": {
				"exec": [
					"const json = pm.response.json();",
					"if (json.success && json.data && json.data.user_id) {",
					"    pm.environment.set(\"user_id\", json.data.user_id);",
					"    pm.environment.set(\"verification_phone\", json.data.phone);",
					"}",
					"pm.test(\"Status code is 201\", function () {",
					"    pm.response.to.have.status(201);",
					"});",
					"pm.test(\"Response has success field\", function () {",
					"    pm.expect(json).to.have.property('success');",
					"});",
					"pm.test(\"Registration successful\", function () {",
					"    if (json.success) {",
					"        pm.expect(json.data).to.have.property('user_id');",
					"        pm.expect(json.data).to.have.property('phone');",
					"    }",
					"});"
				],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"{{test_name}}\",\n  \"phone\": \"{{test_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"confirm_password\": \"{{test_password}}\",\n  \"user_type\": \"customer\",\n  \"language\": \"{{language}}\",\n  \"fcm_token\": \"{{fcm_token}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/cyclex/register",
					"host": ["{{base_url}}"],
					"path": ["api", "cyclex", "register"]
				}
			},
			"response": []
		}
	]
}