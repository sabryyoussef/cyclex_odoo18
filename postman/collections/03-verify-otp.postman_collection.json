{
	"info": {
		"name": "03 - Verify OTP",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Verify Phone Number",
			"event": [
				{
					"listen": "test",
					"script": {
				"exec": [
					"const json = pm.response.json();",
					"if (json.success && json.data && json.data.user_id) {",
					"    pm.environment.set(\"user_id\", json.data.user_id);",
					"    pm.environment.set(\"user_verified\", \"true\");",
					"}",
					"// Capture session cookie for authentication after verification",
					"const cookies = pm.cookies.toObject();",
					"if (cookies.session_id) {",
					"    pm.environment.set(\"session_id\", cookies.session_id);",
					"}",
					"pm.test(\"Status code is 200\", function () {",
					"    pm.response.to.have.status(200);",
					"});",
					"pm.test(\"Response has success field\", function () {",
					"    pm.expect(json).to.have.property('success');",
					"});",
					"pm.test(\"User is verified\", function () {",
					"    if (json.success) {",
					"        pm.expect(json.data.verified).to.be.true;",
					"    }",
					"});"
				],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"phone\": \"{{verification_phone}}\",\n  \"verification_code\": \"{{verification_code}}\",\n  \"password\": \"{{test_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/cyclex/verify",
					"host": ["{{base_url}}"],
					"path": ["api", "cyclex", "verify"]
				}
			},
			"response": []
		}
	]
}