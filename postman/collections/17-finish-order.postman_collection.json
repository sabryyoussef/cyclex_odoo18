{
	"info": {
		"name": "17 - Finish Order",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Recycling Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();",
							"if (json.success && json.data && json.data.request_id) {",
							"    pm.environment.set(\"created_request_id\", json.data.request_id);",
							"}",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has success field\", function () {",
							"    pm.expect(json).to.have.property('success');",
							"});",
							"pm.test(\"Request created successfully\", function () {",
							"    if (json.success) {",
							"        pm.expect(json.data).to.have.property('request_id');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "session_id={{session_id}}",
						"description": "Odoo session authentication"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"{{plastic_product_id}}\",\n      \"quantity\": 5,\n      \"weight\": 3.5\n    },\n    {\n      \"item_name\": \"Mixed plastic bottles\",\n      \"quantity\": 1,\n      \"weight\": 1.2\n    }\n  ],\n  \"pickup_address_id\": \"{{user_address_id}}\",\n  \"preferred_date\": \"2025-11-15\",\n  \"preferred_time_slot\": \"morning\",\n  \"notes\": \"Please call on arrival\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/cyclex/request/create",
					"host": ["{{base_url}}"],
					"path": ["api", "cyclex", "request", "create"]
				}
			},
			"response": []
		}
	]
}

