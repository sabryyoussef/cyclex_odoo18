{
	"id": "cyclex-local-env",
	"name": "CycleX-Local",
	"values": [
		{
			"key": "odoo_host",
			"value": "http://localhost:8069",
			"type": "default",
			"enabled": true,
			"description": "Local Odoo server URL"
		},
		{
			"key": "api_prefix",
			"value": "/api/cyclex",
			"type": "default",
			"enabled": true,
			"description": "API prefix for CycleX endpoints"
