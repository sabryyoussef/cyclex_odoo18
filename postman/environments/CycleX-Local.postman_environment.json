			"enabled": true,
			"description": "Odoo session ID for authentication (extracted from login cookies)"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "default",
			"enabled": true,
			"description": "Current user ID (set automatically after login)"
		},
		{
			"key": "user_name",
			"value": "",
			"type": "default",
			"enabled": true,
			"description": "Current user name (set automatically after login)"
		},
		{
			"key": "user_type",
			"value": "",
			"type": "default",
			"enabled": true,
			"description": "User type: customer or collector (set automatically after login)"
