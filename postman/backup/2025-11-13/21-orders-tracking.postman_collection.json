{
	"info": {
		"name": "21 - Orders Tracking",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Order Details",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/orders/:order_id",
					"host": ["{{base_url}}"],
					"path": ["orders", ":order_id"],
					"variable": [
						{
							"key": "order_id",
							"value": "1"
						}
					]
				}
			},
			"response": []
		}
	]
}

