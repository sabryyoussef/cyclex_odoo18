{
	"info": {
		"name": "11 - Category Items (Metal)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Metal Category Items",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/catalog/categories/METAL/items?language={{language}}",
					"host": ["{{base_url}}"],
					"path": ["catalog", "categories", "METAL", "items"],
					"query": [
						{
							"key": "language",
							"value": "{{language}}"
						}
					]
				}
			},
			"response": []
		}
	]
}

