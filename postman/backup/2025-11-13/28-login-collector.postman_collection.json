{
	"info": {
		"name": "28 - Login (Collector)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login (collector)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();",
							"if (json.token) {",
							"    pm.environment.set(\"auth_token\", json.token);",
							"}",
							"if (json.collector && json.collector.id) {",
							"    pm.environment.set(\"collector_id\", json.collector.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"phone\": \"01000000000\",\n  \"password\": \"secret123\",\n  \"role\": \"collector\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth/login",
					"host": ["{{base_url}}"],
					"path": ["auth", "login"]
				}
			},
			"response": []
		}
	]
}

