{
	"info": {
		"name": "20 - Active Orders",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get Active Orders",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/orders?status=active",
					"host": ["{{base_url}}"],
					"path": ["orders"],
					"query": [
						{
							"key": "status",
							"value": "active"
						}
					]
				}
			},
			"response": []
		}
	]
}

