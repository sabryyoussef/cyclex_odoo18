<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Dashboard Action -->
        <record id="action_cyclex_dashboard" model="ir.actions.client">
            <field name="name">CycleX Dashboard</field>
            <field name="tag">cyclex_dashboard</field>
        </record>
        
        <!-- Request Analysis Action (Pivot View) -->
        <record id="action_cyclex_request_analysis" model="ir.actions.act_window">
            <field name="name">Request Analysis</field>
            <field name="res_model">cyclex.request</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="context">{
                'search_default_group_status': 1,
                'search_default_collected': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No requests to analyze yet
                </p>
            </field>
        </record>

        <!-- Request Graph View -->
        <record id="view_cyclex_request_graph" model="ir.ui.view">
            <field name="name">cyclex.request.graph</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <graph string="Request Analysis" type="bar" sample="1">
                    <field name="status" type="row"/>
                    <field name="calculated_price" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Request Pivot View -->
        <record id="view_cyclex_request_pivot" model="ir.ui.view">
            <field name="name">cyclex.request.pivot</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <pivot string="Request Pivot" sample="1">
                    <field name="product_id" type="row"/>
                    <field name="status" type="col"/>
                    <field name="calculated_price" type="measure"/>
                    <field name="weight" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Commission Analysis Action -->
        <record id="action_cyclex_commission_analysis" model="ir.actions.act_window">
            <field name="name">Commission Analysis</field>
            <field name="res_model">cyclex.commission</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="context">{
                'search_default_group_collector': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No commissions to analyze yet
                </p>
            </field>
        </record>

        <!-- Commission Graph View -->
        <record id="view_cyclex_commission_graph" model="ir.ui.view">
            <field name="name">cyclex.commission.graph</field>
            <field name="model">cyclex.commission</field>
            <field name="arch" type="xml">
                <graph string="Commission Analysis" type="bar" sample="1">
                    <field name="collector_id" type="row"/>
                    <field name="commission_amount" type="measure"/>
                    <field name="order_value" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Commission Pivot View -->
        <record id="view_cyclex_commission_pivot" model="ir.ui.view">
            <field name="name">cyclex.commission.pivot</field>
            <field name="model">cyclex.commission</field>
            <field name="arch" type="xml">
                <pivot string="Commission Pivot" sample="1">
                    <field name="collector_id" type="row"/>
                    <field name="status" type="col"/>
                    <field name="commission_amount" type="measure"/>
                    <field name="order_value" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Wallet Transaction Graph View -->
        <record id="view_cyclex_wallet_transaction_graph" model="ir.ui.view">
            <field name="name">cyclex.wallet.transaction.graph</field>
            <field name="model">cyclex.wallet.transaction</field>
            <field name="arch" type="xml">
                <graph string="Transaction Analysis" type="line" sample="1">
                    <field name="create_date" interval="day" type="row"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Wallet Transaction Pivot View -->
        <record id="view_cyclex_wallet_transaction_pivot" model="ir.ui.view">
            <field name="name">cyclex.wallet.transaction.pivot</field>
            <field name="model">cyclex.wallet.transaction</field>
            <field name="arch" type="xml">
                <pivot string="Transaction Pivot" sample="1">
                    <field name="customer_id" type="row"/>
                    <field name="transaction_type" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Transaction Analysis Action -->
        <record id="action_cyclex_wallet_transaction_analysis" model="ir.actions.act_window">
            <field name="name">Transaction Analysis</field>
            <field name="res_model">cyclex.wallet.transaction</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No transactions to analyze yet
                </p>
            </field>
        </record>

        <!-- Top Collectors Action (Collectors sorted by total commissions) -->
        <record id="action_cyclex_top_collectors" model="ir.actions.act_window">
            <field name="name">Top Collectors</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('cyclex_user_type', '=', 'collector'), ('collector_approval_status', '=', 'approved')]</field>
            <field name="context">{
                'search_default_group_vehicle': 0
            }</field>
            <field name="search_view_id" ref="view_cyclex_collector_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No collectors yet
                </p>
            </field>
        </record>

        <!-- Active Customers Report -->
        <record id="action_cyclex_active_customers" model="ir.actions.act_window">
            <field name="name">Active Customers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('cyclex_user_type', '=', 'customer'), ('account_status', '=', 'active'), ('phone_verified', '=', True)]</field>
            <field name="context">{
                'search_default_group_language': 0
            }</field>
            <field name="search_view_id" ref="view_cyclex_customer_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No active customers yet
                </p>
            </field>
        </record>

        <!-- Product Popularity Report (Products by request count) -->
        <record id="action_cyclex_product_popularity" model="ir.actions.act_window">
            <field name="name">Product Popularity</field>
            <field name="res_model">cyclex.product</field>
            <field name="view_mode">list,kanban,graph</field>
            <field name="context">{
                'search_default_group_category': 1,
                'search_default_active': 1
            }</field>
            <field name="search_view_id" ref="view_cyclex_product_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No products yet
                </p>
            </field>
        </record>

        <!-- Product Graph View for Popularity -->
        <record id="view_cyclex_product_graph" model="ir.ui.view">
            <field name="name">cyclex.product.graph</field>
            <field name="model">cyclex.product</field>
            <field name="arch" type="xml">
                <graph string="Product Popularity" type="pie" sample="1">
                    <field name="name" type="row"/>
                    <field name="request_count" type="measure"/>
                </graph>
            </field>
        </record>

    </data>
</odoo>

