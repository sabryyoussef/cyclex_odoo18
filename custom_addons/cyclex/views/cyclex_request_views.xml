<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Request List View -->
        <record id="view_cyclex_request_tree" model="ir.ui.view">
            <field name="name">cyclex.request.tree</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <list string="Requests">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="product_id"/>
                    <field name="weight"/>
                    <field name="calculated_price" widget="monetary"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="pickup_date"/>
                    <field name="status" decoration-info="status == 'draft'" decoration-primary="status == 'pending'" decoration-warning="status == 'assigned'" decoration-success="status == 'collected'" decoration-danger="status == 'cancelled'" widget="badge"/>
                    <field name="collector_id"/>
                </list>
            </field>
        </record>

        <!-- Request Form View -->
        <record id="view_cyclex_request_form" model="ir.ui.view">
            <field name="name">cyclex.request.form</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <form string="Request">
                    <header>
                        <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="status != 'draft'"/>
                        <button name="action_assign_collector" string="Assign Collector" type="object" class="btn-warning" invisible="status != 'pending'"/>
                        <button name="action_mark_collected" string="Mark Collected" type="object" class="btn-success" invisible="status != 'assigned'"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="status in ['collected', 'cancelled']"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,pending,assigned,collected"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_wallet_transactions" type="object" class="oe_stat_button" icon="fa-money" invisible="status != 'collected'">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Wallet</span>
                                    <span class="o_stat_text">Transaction</span>
                                </div>
                            </button>
                            <button name="action_view_commission" type="object" class="oe_stat_button" icon="fa-percent" invisible="status != 'collected' or not collector_id">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Collector</span>
                                    <span class="o_stat_text">Commission</span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Draft" bg_color="text-bg-secondary" invisible="status != 'draft'"/>
                        <widget name="web_ribbon" title="Pending" bg_color="text-bg-primary" invisible="status != 'pending'"/>
                        <widget name="web_ribbon" title="Assigned" bg_color="text-bg-warning" invisible="status != 'assigned'"/>
                        <widget name="web_ribbon" title="Collected" bg_color="text-bg-success" invisible="status != 'collected'"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="status != 'cancelled'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Request Information">
                                <field name="customer_id" readonly="status != 'draft'"/>
                                <field name="category_id" readonly="status != 'draft'"/>
                                <field name="product_id" readonly="status != 'draft'"/>
                                <field name="quantity" readonly="status != 'draft'"/>
                                <field name="weight" readonly="status != 'draft'"/>
                                <field name="calculated_price" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Pickup Information">
                                <field name="pickup_date" readonly="status != 'draft'"/>
                                <field name="collector_id" readonly="status not in ['pending', 'assigned']"/>
                                <field name="gps_latitude"/>
                                <field name="gps_longitude"/>
                            </group>
                        </group>
                        <group>
                            <group string="Photos">
                                <field name="photo_1" widget="image" readonly="status not in ['draft', 'pending']"/>
                                <field name="photo_2" widget="image" readonly="status not in ['draft', 'pending']"/>
                            </group>
                            <group string="QR Code &amp; Rating">
                                <field name="qr_code" readonly="1"/>
                                <field name="qr_code_image" widget="image" readonly="1" options="{'size': [200, 200]}"/>
                                <field name="rating" widget="priority" readonly="status != 'collected'"/>
                                <field name="comments" readonly="status != 'collected'"/>
                            </group>
                        </group>
                        <group string="Dates">
                            <field name="create_date"/>
                            <field name="completion_date"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Request Kanban View (Status Pipeline) -->
        <record id="view_cyclex_request_kanban" model="ir.ui.view">
            <field name="name">cyclex.request.kanban</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="collector_id"/>
                    <field name="product_id"/>
                    <field name="weight"/>
                    <field name="calculated_price"/>
                    <field name="pickup_date"/>
                    <field name="status"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                                            <span class="o_kanban_record_subtitle"><field name="customer_id"/></span>
                                        </div>
                                        <div class="o_dropdown_kanban dropdown">
                                            <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                                <span class="fa fa-ellipsis-v"/>
                                            </a>
                                            <div class="dropdown-menu" role="menu">
                                                <a t-if="record.status.raw_value == 'pending'" role="menuitem" type="object" name="action_assign_collector" class="dropdown-item">Assign Collector</a>
                                                <a t-if="record.status.raw_value == 'assigned'" role="menuitem" type="object" name="action_mark_collected" class="dropdown-item">Mark Collected</a>
                                                <a t-if="record.status.raw_value not in ['collected', 'cancelled']" role="menuitem" type="object" name="action_cancel" class="dropdown-item">Cancel</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div><i class="fa fa-box"/> <field name="product_id"/></div>
                                        <div><i class="fa fa-balance-scale"/> <field name="weight"/> kg</div>
                                        <div class="text-success"><strong><field name="calculated_price" widget="monetary"/></strong></div>
                                        <div t-if="record.collector_id.raw_value"><i class="fa fa-truck"/> <field name="collector_id"/></div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span><i class="fa fa-calendar"/> <field name="pickup_date"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Request Calendar View -->
        <record id="view_cyclex_request_calendar" model="ir.ui.view">
            <field name="name">cyclex.request.calendar</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <calendar string="Request Calendar" date_start="pickup_date" color="status" mode="month">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="collector_id"/>
                    <field name="product_id"/>
                    <field name="calculated_price"/>
                    <field name="status"/>
                </calendar>
            </field>
        </record>

        <!-- Request Search View -->
        <record id="view_cyclex_request_search" model="ir.ui.view">
            <field name="name">cyclex.request.search</field>
            <field name="model">cyclex.request</field>
            <field name="arch" type="xml">
                <search string="Search Requests">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="collector_id"/>
                    <field name="product_id"/>
                    <field name="category_id"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                    <filter string="Assigned" name="assigned" domain="[('status', '=', 'assigned')]"/>
                    <filter string="Collected" name="collected" domain="[('status', '=', 'collected')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Unassigned" name="unassigned" domain="[('collector_id', '=', False), ('status', '=', 'pending')]"/>
                    <filter string="Today's Pickups" name="today" domain="[('pickup_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('pickup_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                    <filter string="This Week" name="this_week" domain="[('pickup_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('pickup_date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                        <filter string="Collector" name="group_collector" context="{'group_by': 'collector_id'}"/>
                        <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Pickup Date" name="group_pickup_date" context="{'group_by': 'pickup_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Request Action -->
        <record id="action_cyclex_request" model="ir.actions.act_window">
            <field name="name">Requests</field>
            <field name="res_model">cyclex.request</field>
            <field name="view_mode">kanban,list,calendar,form</field>
            <field name="search_view_id" ref="view_cyclex_request_search"/>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No requests yet
                </p>
                <p>
                    Customer requests are created via the mobile app and appear here for processing.
                </p>
            </field>
        </record>

        <!-- Unassigned Requests Action -->
        <record id="action_cyclex_request_unassigned" model="ir.actions.act_window">
            <field name="name">Unassigned Requests</field>
            <field name="res_model">cyclex.request</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('status', '=', 'pending'), ('collector_id', '=', False)]</field>
            <field name="context">{'search_default_unassigned': 1}</field>
            <field name="search_view_id" ref="view_cyclex_request_search"/>
        </record>
        
    </data>
</odoo>
