<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Product List View -->
        <record id="view_cyclex_product_tree" model="ir.ui.view">
            <field name="name">cyclex.product.tree</field>
            <field name="model">cyclex.product</field>
            <field name="arch" type="xml">
                <list string="Products">
                    <field name="image" widget="image" width="50px" height="50px"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="price_per_kg" widget="monetary"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Product Form View -->
        <record id="view_cyclex_product_form" model="ir.ui.view">
            <field name="name">cyclex.product.form</field>
            <field name="model">cyclex.product</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Product Name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="category_id" required="1"/>
                                <field name="price_per_kg" required="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="request_count"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Product description..." nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Product Kanban View -->
        <record id="view_cyclex_product_kanban" model="ir.ui.view">
            <field name="name">cyclex.product.kanban</field>
            <field name="model">cyclex.product</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="price_per_kg"/>
                    <field name="image"/>
                    <field name="currency_id"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('cyclex.product', 'image', record.id.raw_value)" alt="Product Image" class="o_image_64_cover"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div><field name="category_id"/></div>
                                        <div class="text-success"><strong><field name="price_per_kg" widget="monetary"/> / kg</strong></div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <span t-if="!record.active.raw_value" class="badge badge-secondary">Archived</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Product Search View -->
        <record id="view_cyclex_product_search" model="ir.ui.view">
            <field name="name">cyclex.product.search</field>
            <field name="model">cyclex.product</field>
            <field name="arch" type="xml">
                <search string="Search Products">
                    <field name="name"/>
                    <field name="category_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Plastic Products" name="plastic" domain="[('category_id.parent_id.name', 'ilike', 'Plastic')]"/>
                    <filter string="Metal Products" name="metal" domain="[('category_id.parent_id.name', 'ilike', 'Metal')]"/>
                    <filter string="Paper Products" name="paper" domain="[('category_id.parent_id.name', 'ilike', 'Paper')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Product Action -->
        <record id="action_cyclex_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">cyclex.product</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_cyclex_product_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first recyclable product
                </p>
                <p>
                    Products define what recyclable items customers can sell, with pricing per kilogram.
                </p>
            </field>
        </record>
        
    </data>
</odoo>

