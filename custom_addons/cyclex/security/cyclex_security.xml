<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- CycleX Module Category -->
        <record id="module_category_cyclex" model="ir.module.category">
            <field name="name">CycleX</field>
            <field name="description">Manage CycleX recycling system permissions</field>
            <field name="sequence">20</field>
        </record>

        <!-- CycleX Customer Group -->
        <record id="group_cyclex_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="category_id" ref="module_category_cyclex"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">CycleX customers can create requests and manage their wallet. Implied Internal User is required for mail.thread / request ORM access on the July 2026 API path.</field>
        </record>

        <!-- CycleX Collector Group -->
        <record id="group_cyclex_collector" model="res.groups">
            <field name="name">Collector</field>
            <field name="category_id" ref="module_category_cyclex"/>
            <field name="implied_ids" eval="[(4, ref('group_cyclex_customer'))]"/>
            <field name="comment">CycleX collectors can accept and complete orders</field>
        </record>

        <!-- CycleX Manager Group -->
        <record id="group_cyclex_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_cyclex"/>
            <field name="implied_ids" eval="[(4, ref('group_cyclex_collector'))]"/>
            <field name="comment">CycleX managers can manage categories, products, and approve collectors</field>
        </record>

        <!-- CycleX Admin Group -->
        <record id="group_cyclex_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_cyclex"/>
            <field name="implied_ids" eval="[(4, ref('group_cyclex_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">CycleX administrators have full access to all features</field>
        </record>

        <!-- Multi-company Rule for CycleX Records -->
        <record id="cyclex_comp_rule" model="ir.rule">
            <field name="name">CycleX multi-company</field>
            <field name="model_id" ref="model_cyclex_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>

