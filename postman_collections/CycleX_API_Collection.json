{
	"info": {
		"_postman_id": "cyclex-api-collection-v1",
		"name": "CycleX API - Complete Collection",
		"description": "Complete API collection for CycleX Recycling Mobile Application.\n\n**Base URL:** http://localhost:10018 (update in environment)\n\n**Authentication:** Session-based (auth_token cookie)\n\n**Total Endpoints:** 22\n\n**Categories:**\n- Authentication (4 endpoints)\n- Categories & Products (2 endpoints)\n- Requests (4 endpoints)\n- Collector Actions (4 endpoints)\n- Wallet (4 endpoints)\n- Profile (3 endpoints)\n- Commission (1 endpoint)\n\n**Created for:** Odoo 18 Backend\n**Date:** October 2025",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"name\": \"Ahmed Hassan\",\n        \"phone\": \"+201234567890\",\n        \"password\": \"TestPass123\",\n        \"email\": \"ahmed@example.com\",\n        \"user_type\": \"customer\",\n        \"language\": \"ar\"\n    },\n    \"id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/cyclex/register",
							"host": ["{{base_url}}"],
							"path": ["api", "cyclex", "register"]
						},
						"description": "Register a new user (customer or collector).\n\n**Required:**\n- name\n- phone (Egyptian format: +20XXXXXXXXXX)\n- password (min 8 chars, uppercase, lowercase, number)\n- user_type (customer/collector)\n\n**Optional:**\n- email\n- language (ar/en, default: ar)\n\n**Note:** Verification code will be sent via SMS in Phase 7"
					},
					"response": []
				},
				{
					"name": "1.2 Verify Phone",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"phone\": \"+201234567890\",\n        \"code\": \"123456\"\n    },\n    \"id\": 2\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/cyclex/verify",
							"host": ["{{base_url}}"],
							"path": ["api", "cyclex", "verify"]
						},
						"description": "Verify phone number with 6-digit code.\n\n**Required:**\n- phone\n- code (6-digit verification code)\n\n**Returns:** Auth session"
					},
					"response": []
				},
