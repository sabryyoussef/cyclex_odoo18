							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"phone\": \"+201234567890\",\n        \"password\": \"TestPass123\"\n    },\n    \"id\": 3\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/cyclex/login",
							"host": ["{{base_url}}"],
							"path": ["api", "cyclex", "login"]
						},
						"description": "Login with phone and password.\n\n**Required:**\n- phone\n- password\n\n**Returns:** User data and auth session"
					},
					"response": []
